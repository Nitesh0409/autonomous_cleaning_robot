<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="arm_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <!-- Open ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- TARGET OBJECT: small red cube robot arm should pick up -->
    <!-- Placed 0.32m in front of robot spawn (robot spawns at 0,0) -->
    <model name="target_cube">
      <pose>0.35 0 0.05 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.08</mass></inertial>
        <collision name="c">
          <geometry><box><size>0.08 0.08 0.10</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.08 0.08 0.10</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- DROP ZONE: coloured mat at (1.5, 0) — robot drives there and deposits -->
    <model name="drop_zone_mat">
      <static>true</static>
      <pose>1.5 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.50 0.50 0.01</size></box></geometry>
          <material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.1 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Drop zone label border (white frame) -->
    <model name="drop_zone_frame">
      <static>true</static>
      <pose>1.5 0 0.008 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.54 0.54 0.006</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Distance reference pillars so user knows scale -->
    <model name="ref_0_25">
      <static>true</static><pose>0.25 -0.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.02</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
