<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="dynamic_cleaner_world">
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>0</real_time_update_rate>
        </physics>
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>false</cast_shadows>

            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
                </collision>
                <visual name="visual">
                    <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
                    <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
                </visual>
            </link>
        </model>

        <!-- STATIC OBSTACLES (The Trap) -->
        <model name="u_trap">
            <static>true</static>
            <pose>3.0 0.0 0.5 0 0 0</pose>
            <link name="back"><collision name="c"><geometry><box><size>0.1 2.0 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 2.0 1.0</size></box></geometry></visual></link>
            <link name="top"><pose>-0.5 1.0 0 0 0 0</pose><collision name="c"><geometry><box><size>1.0 0.1 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.1 1.0</size></box></geometry></visual></link>
            <link name="bot"><pose>-0.5 -1.0 0 0 0 0</pose><collision name="c"><geometry><box><size>1.0 0.1 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.1 1.0</size></box></geometry></visual></link>
        </model>

        <!-- DYNAMIC OBSTACLE (To-and-Fro) -->
        <!-- Note: Scripted movement via plugin -->
        <model name="patrol_box">
            <pose>1.5 1.5 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>0.5 0.5 1.0</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>0.5 0.5 1.0</size></box></geometry><material><ambient>1 1 0 1</ambient></material></visual>
            </link>
            <plugin filename="gz-sim-linearbatteryplugin-system" name="gz::sim::systems::LinearBatteryPlugin"></plugin>
            <!-- Using Python script or Actor for better cyclic motion, but here we define placeholder -->
        </model>

        <!-- GARBAGE TARGET -->
        <model name="garbage_bag">
            <static>false</static>
            <pose>4.0 2.0 0.15 0 0 0</pose>
            <link name="link">
                <inertial>
                    <mass>0.2</mass>
                    <inertia>
                        <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
                    </inertia>
                </inertial>
                <collision name="c">
                    <geometry><sphere><radius>0.15</radius></sphere></geometry>
                    <surface>
                        <friction>
                            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="v">
                    <geometry><sphere><radius>0.15</radius></sphere></geometry>
                    <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
                </visual>
            </link>
        </model>
    </world>
</sdf>
