Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: odom
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Front Lidar
      Topic:
        Value: /front_scan
      Size (m): 0.05
      Style: Points
      Color: 255; 0; 0
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Rear Lidar
      Topic:
        Value: /rear_scan
      Size (m): 0.05
      Style: Points
      Color: 255; 100; 0
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: DWA Intent
      Topic:
        Value: /dwa_trajectories
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Brain Search Frontier
      Topic:
        Value: /search_frontier
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Obstacle Grid
      Topic:
        Value: /grid_markers
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Global Plan
      Topic:
        Value: /plan
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.05
  Enabled: true
  Global Options:
    Fixed Frame: odom
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
