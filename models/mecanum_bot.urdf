<?xml version="1.0"?>
<robot name="robot">

  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual><geometry><box size="0.3 0.2 0.05"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="0.3 0.2 0.05"/></geometry></collision>
    <inertial>
      <mass value="1.2"/>
      <origin xyz="0 0 -0.02"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="laser_frame">
    <visual><geometry><cylinder radius="0.02" length="0.01"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.02" length="0.01"/></geometry></collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_frame"/><origin xyz="0.1 0 0.30" rpy="0 0 0"/>
  </joint>

  <!-- WHEEL DEFINITIONS (15mm CLEARANCE) -->
  <link name="front_left_wheel">
    <visual><geometry><cylinder radius="0.0325" length="0.02"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.0325" length="0.02"/></geometry>
      <surface><friction><ode><mu>2.0</mu><mu2>1.5</mu2><fdir1>1 1 0</fdir1></ode></friction></surface>
    </collision>
    <inertial><mass value="0.15"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_left_wheel"/><origin xyz="0.1 0.12 -0.0275" rpy="1.5707 0 0"/><axis xyz="0 0 -1"/></joint>

  <link name="front_right_wheel">
    <visual><geometry><cylinder radius="0.0325" length="0.02"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.0325" length="0.02"/></geometry>
      <surface><friction><ode><mu>2.0</mu><mu2>1.5</mu2><fdir1>1 -1 0</fdir1></ode></friction></surface>
    </collision>
    <inertial><mass value="0.15"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_right_wheel"/><origin xyz="0.1 -0.12 -0.0275" rpy="1.5707 0 0"/><axis xyz="0 0 -1"/></joint>

  <link name="back_left_wheel">
    <visual><geometry><cylinder radius="0.0325" length="0.02"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.0325" length="0.02"/></geometry>
      <surface><friction><ode><mu>2.0</mu><mu2>1.5</mu2><fdir1>1 -1 0</fdir1></ode></friction></surface>
    </collision>
    <inertial><mass value="0.15"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="back_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="back_left_wheel"/><origin xyz="-0.1 0.12 -0.0275" rpy="1.5707 0 0"/><axis xyz="0 0 -1"/></joint>

  <link name="back_right_wheel">
    <visual><geometry><cylinder radius="0.0325" length="0.02"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.0325" length="0.02"/></geometry>
      <surface><friction><ode><mu>2.0</mu><mu2>1.5</mu2><fdir1>1 1 0</fdir1></ode></friction></surface>
    </collision>
    <inertial><mass value="0.15"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="back_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="back_right_wheel"/><origin xyz="-0.1 -0.12 -0.0275" rpy="1.5707 0 0"/><axis xyz="0 0 -1"/></joint>

  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="front_left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="front_right_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="back_left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="back_right_wheel"><material>Gazebo/Black</material></gazebo>

  <gazebo reference="laser_frame">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate><visualize>true</visualize><topic>/scan</topic>
      <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14</min_angle><max_angle>3.14</max_angle></horizontal></scan><range><min>0.15</min><max>20.0</max></range></lidar>
      <gz_frame_id>laser_frame</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>back_left_wheel_joint</back_left_joint>
      <back_right_joint>back_right_wheel_joint</back_right_joint>
      <wheel_radius>0.0325</wheel_radius>
      <topic>/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </gazebo>
</robot>
