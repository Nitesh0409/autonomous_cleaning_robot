<?xml version="1.0"?>
<robot name="robot">


  <material name="silver"><color rgba="0.75 0.75 0.75 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="green"><color rgba="0 0.8 0 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.06" rpy="0 0 0"/></joint>

  <!-- MICRO-SENTINEL CHASSIS (0.28m - The Definitive Compact) -->
  <link name="base_link">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.28 0.2 0.05"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.26 0.18 0.04"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- UNIFIED COLLECTION BUCKET (Continuous Box) -->
  <link name="collection_bucket">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.14 0.18 0.01"/></geometry><material name="black"/></visual> <!-- Bottom -->
    <visual><origin xyz="-0.065 0 0.05"/><geometry><box size="0.01 0.18 0.1"/></geometry><material name="black"/></visual> <!-- Rear -->
    <visual><origin xyz="0.065 0 0.05"/><geometry><box size="0.01 0.18 0.1"/></geometry><material name="black"/></visual> <!-- Front -->
    <visual><origin xyz="0 0.085 0.05"/><geometry><box size="0.12 0.01 0.1"/></geometry><material name="black"/></visual> <!-- Left -->
    <visual><origin xyz="0 -0.085 0.05"/><geometry><box size="0.12 0.01 0.1"/></geometry><material name="black"/></visual> <!-- Right -->
    <collision><origin xyz="0 0 0"/><geometry><box size="0.14 0.18 0.01"/></geometry></collision>
    <collision><origin xyz="-0.065 0 0.05"/><geometry><box size="0.01 0.18 0.1"/></geometry></collision>
    <collision><origin xyz="0.065 0 0.05"/><geometry><box size="0.01 0.18 0.1"/></geometry></collision>
    <collision><origin xyz="0 0.085 0.05"/><geometry><box size="0.12 0.01 0.1"/></geometry></collision>
    <collision><origin xyz="0 -0.085 0.05"/><geometry><box size="0.12 0.01 0.1"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="bucket_joint" type="fixed"><parent link="base_link"/><child link="collection_bucket"/><origin xyz="-0.06 0 0.03" rpy="0 0 0"/></joint>

  <!-- ARM PEDESTAL -->
  <link name="pedestal">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.06 0.06 0.04"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.06 0.06 0.04"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="pedestal_joint" type="fixed"><parent link="base_link"/><child link="pedestal"/><origin xyz="0.05 0 0.045" rpy="0 0 0"/></joint>

  <!-- MECANUM WHEELS (Direct Local Mesh Calibration) -->
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <mesh filename="package://robot/meshes/mecanum_wheel.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="1.5707 0 0"/><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
    <inertial><mass value="0.25"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <mesh filename="package://robot/meshes/mecanum_wheel.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="1.5707 0 0"/><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
    <inertial><mass value="0.25"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <mesh filename="package://robot/meshes/mecanum_wheel.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="1.5707 0 0"/><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
    <inertial><mass value="0.25"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <mesh filename="package://robot/meshes/mecanum_wheel.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="1.5707 0 0"/><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
    <inertial><mass value="0.25"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_left_wheel"/><origin xyz="0.10 0.12 -0.0275" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="front_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_right_wheel"/><origin xyz="0.10 -0.12 -0.0275" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_left_wheel"/><origin xyz="-0.10 0.12 -0.0275" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_right_wheel"/><origin xyz="-0.10 -0.12 -0.0275" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>

  <!-- MANIPULATOR (Grabbing Pose) -->
  <link name="arm_base">
    <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry><material name="silver"/></visual>
    <inertial><mass value="0.001"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="arm_mount" type="fixed"><parent link="pedestal"/><child link="arm_base"/><origin xyz="0 0 0.04" rpy="0 0 0"/></joint>

  <link name="arm_upper">
    <visual><origin xyz="0 0 0.06" rpy="0 0 0"/><geometry><box size="0.03 0.03 0.12"/></geometry><material name="silver"/></visual>
    <inertial><mass value="0.001"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="j1" type="revolute"><parent link="arm_base"/><child link="arm_upper"/><origin xyz="0 0 0.02" rpy="0 0.7 0"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="10" velocity="1"/></joint>

  <link name="arm_lower">
    <visual><origin xyz="0 0 0.06" rpy="0 0 0"/><geometry><box size="0.03 0.03 0.12"/></geometry><material name="silver"/></visual>
    <inertial><mass value="0.001"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="j2" type="revolute"><parent link="arm_upper"/><child link="arm_lower"/><origin xyz="0 0 0.12" rpy="0 0.8 0"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="10" velocity="1"/></joint>

  <link name="gripper_head">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.04 0.1 0.02"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.04 0.1 0.02"/></geometry></collision>
    <inertial><mass value="0.001"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="gripper_base_joint" type="revolute"><parent link="arm_lower"/><child link="gripper_head"/><origin xyz="0 0 0.12" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="0" upper="0" effort="0" velocity="0"/></joint>

  <!-- ACTIVE GRIPPER (Closes to carry objects) -->
  <link name="finger_left">
    <visual><origin xyz="0.025 0 0" rpy="0 0 0"/><geometry><box size="0.05 0.01 0.03"/></geometry><material name="silver"/></visual>
    <collision><origin xyz="0.025 0 0" rpy="0 0 0"/><geometry><box size="0.05 0.01 0.03"/></geometry></collision>
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="f_left_j" type="revolute">
    <parent link="gripper_head"/><child link="finger_left"/><origin xyz="0.02 0.04 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-0.8" upper="0.8" effort="1.0" velocity="0.5"/>
  </joint>
  
  <link name="finger_right">
    <visual><origin xyz="0.025 0 0" rpy="0 0 0"/><geometry><box size="0.05 0.01 0.03"/></geometry><material name="silver"/></visual>
    <collision><origin xyz="0.025 0 0" rpy="0 0 0"/><geometry><box size="0.05 0.01 0.03"/></geometry></collision>
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="f_right_j" type="revolute">
    <parent link="gripper_head"/><child link="finger_right"/><origin xyz="0.02 -0.04 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-0.8" upper="0.8" effort="1.0" velocity="0.5"/>
  </joint>

  <!-- SENSORS -->
  <link name="imu_link">
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <link name="front_laser_link">
    <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="front_laser_joint" type="fixed"><parent link="base_link"/><child link="front_laser_link"/><origin xyz="0.13 0 0.06" rpy="0 0 0"/></joint>

  <link name="rear_laser_link">
    <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="rear_laser_joint" type="fixed"><parent link="base_link"/><child link="rear_laser_link"/><origin xyz="-0.13 0 0.06" rpy="0 0 3.14159"/></joint>

  <!-- VISION CAMERA (No collision, mounted with front lidar) -->
  <link name="camera_link">
    <visual><geometry><box size="0.02 0.04 0.02"/></geometry><material name="black"/></visual>
    <inertial><mass value="0.001"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.13 0 0.08" rpy="0 0 0"/></joint>

  <!-- GAZEBO -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
    </sensor>
  </gazebo>
  
  <gazebo reference="front_laser_link">
    <sensor name="front_scan" type="gpu_lidar">
      <topic>/model/robot/front_scan</topic>
      <gz_frame_id>front_laser_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-1.57</min_angle><max_angle>1.57</max_angle></horizontal></scan>
        <range><min>0.05</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
      <always_on>1</always_on><visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="rear_laser_link">
    <sensor name="rear_scan" type="gpu_lidar">
      <topic>/model/robot/rear_scan</topic>
      <gz_frame_id>rear_laser_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-1.57</min_angle><max_angle>1.57</max_angle></horizontal></scan>
        <range><min>0.05</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
      <always_on>1</always_on><visualize>true</visualize>
    </sensor>
  </gazebo>
  
  <gazebo reference="camera_link">
    <sensor name="vision_camera" type="camera">
      <topic>/model/robot/camera</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>100</far></clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- GAZEBO MATERIALS -->
  <gazebo reference="front_left_wheel"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="front_right_wheel"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="rear_left_wheel"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="rear_right_wheel"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>

  <gazebo>
    <!-- ⚠️ MOTION ENGINE: Do NOT modify topics below. Synchronized with Bridge. -->
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheelbase>0.2000</wheelbase>
      <wheel_separation>0.24</wheel_separation><wheel_radius>0.0300</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/robot/joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/model/robot/ground_truth</odom_topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>j1</joint_name><topic>/arm/j1/cmd_pos</topic>
      <p_gain>5000</p_gain><i_gain>0.1</i_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>j2</joint_name><topic>/arm/j2/cmd_pos</topic>
      <p_gain>5000</p_gain><i_gain>0.1</i_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>f_left_j</joint_name><topic>/gripper/left/cmd_pos</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>f_right_j</joint_name><topic>/gripper/right/cmd_pos</topic>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>gripper_head</parent_link>
      <child_model>target_alpha</child_model>
      <child_link>core_link</child_link>
      <topic>/mission/grab_control</topic>
    </plugin>
    <!-- ADVANCED KINEMATICS INSTALLED: Simulates planar omni-directional drive mapping -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <link_name>base_footprint</link_name>
      <topic>/cmd_vel</topic>
    </plugin>
  </gazebo>
  <!-- MECANUM KINEMATICS: Wheels frictionless to accommodate VelocityControl Magic -->
  <gazebo reference="front_left_wheel">
    <mu1>0.0</mu1><mu2>0.0</mu2><fdir1>1 1 0</fdir1><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>0.0</mu1><mu2>0.0</mu2><fdir1>1 -1 0</fdir1><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <mu1>0.0</mu1><mu2>0.0</mu2><fdir1>1 -1 0</fdir1><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>0.0</mu1><mu2>0.0</mu2><fdir1>1 1 0</fdir1><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>

</robot>
