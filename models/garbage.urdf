<?xml version="1.0"?>
<!--
  garbage.urdf
  A small yellow cube representing a piece of dropped garbage.
  Size: 0.10 × 0.10 × 0.10 m  |  Mass: 0.05 kg
  Used by garbage_spawner.py — spawned dynamically at runtime.
-->
<robot name="garbage">

  <link name="base_link">

    <inertial>
      <mass value="0.05"/>
      <!-- Inertia of a solid cube: I = (1/6) * m * a^2, a=0.10 -->
      <inertia ixx="0.0000833" ixy="0" ixz="0"
               iyy="0.0000833" iyz="0"
               izz="0.0000833"/>
    </inertial>

    <collision>
      <geometry>
        <box size="0.10 0.10 0.10"/>
      </geometry>
    </collision>

    <visual>
      <geometry>
        <box size="0.10 0.10 0.10"/>
      </geometry>
      <material name="garbage_yellow">
        <color rgba="0.95 0.82 0.05 1.0"/>
      </material>
    </visual>

  </link>

  <!-- Gazebo-specific material for correct rendering in simulation -->
  <gazebo reference="base_link">
    <material>Gazebo/Yellow</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <selfCollide>false</selfCollide>
  </gazebo>

</robot>
